  "scripts": {
    "build": "rimraf dist && CURVY_SDK_PASS=js tsup && NODE_OPTIONS=--max-old-space-size=8192 CURVY_SDK_PASS=dts tsup && bash scripts/postbuild.sh",
    "build:publish": "rimraf dist && CURVY_SDK_PUBLISH=1 CURVY_SDK_FORMAT=esm CURVY_SDK_PASS=js tsup && NODE_OPTIONS=--max-old-space-size=8192 CURVY_SDK_PUBLISH=1 CURVY_SDK_FORMAT=esm CURVY_SDK_PASS=dts tsup && CURVY_SDK_PUBLISH=1 CURVY_SDK_FORMAT=cjs CURVY_SDK_PASS=js tsup && NODE_OPTIONS=--max-old-space-size=8192 CURVY_SDK_PUBLISH=1 CURVY_SDK_FORMAT=cjs CURVY_SDK_PASS=dts tsup && bash scripts/postbuild.sh",
    "build-win": "node scripts/build.mjs",
    "build-publish-win": "node scripts/build.mjs --publish",
    "watch": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "check:packages": "pnpm up --latest --interactive",
    "prepublishOnly": "pnpm run test:build",
    "test": "vitest run src",
    "test:build": "pnpm run build:publish && publint --strict && CURVY_SDK_SKIP_PREPARE=1 npm_config_cache=/tmp/curvy-sdk-npm-cache attw --pack --profile node16",
    "prepare": "node scripts/prepare.mjs"
  },
